{% extends 'base.html.twig' %}

{% set menu_bondy = true %}
{% set menu_manage_prj_bondy = true %}

{% block body %}
    <div class="page-header justify-content-between">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href={{ path('admin_dashboard') }}>Accueil</a>
                </li>
                <li class="breadcrumb-item">
                    <a href={{ path('project_parent_list') }}>Gestion projets Bondy</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Modification projet Bondy</li>
            </ol>
        </nav>
        <div>
            <a href="{{ current_url }}" class="btn btn-outline-primary" title="List">Retour</a>
        </div>
    </div>
    <div class="row">
        <div class="col-md-3">
            <div class="card">
                <div class="app-sidebar-menu">
                    <div class="list-group list-group-flush">
                        <a href="#infoge" class="list-group-item active d-flex align-items-center">
                            <i data-feather="globe" class="mr-2 width-15 height-15"></i>
                            Informations générales
                        </a>
                        <a href="#localisation" class="list-group-item d-flex align-items-center">
                            <i data-feather="map-pin" class="mr-2 width-15 height-15"></i>
                            Localisation
                        </a>
                        <a href="#history" class="list-group-item d-flex align-items-center">
                            <i data-feather="book" class="mr-2 width-15 height-15"></i>
                            Histoire du projet
                        </a>
                        <a href="#galerie" class="list-group-item d-flex align-items-center">
                            <i data-feather="image" class="mr-2 width-15 height-15"></i>
                            Galerie
                        </a>
                        <a href="#sous-projets" class="list-group-item d-flex align-items-center">
                            <i data-feather="folder-plus" class="mr-2 width-15 height-15"></i>
                            Sous-projets
                        </a>
                    </div>

                </div>
            </div>
        </div>
        <div class="col-md-9">
            <div class="card" id="infoge">
                <div class="card-header">
                    Informations générales
                </div>
                <div class="card-body">
                    <form id="information_general" action="{{ path('project_parent_edit', {'id': projectParent.id}) }}" method="POST"
                          enctype="multipart/form-data">
                        <div class="group-upload">
                            <label>Bannière image <span class="text-danger">*</span></label>
                            <small class="ml-1">(Dimension 707x205px)</small>
                            <div class="boxBanner">
                                <span class="ico-close">+</span>
                                <img class="boxBanner_img" src="{{ projectParent.bannerImage }}" alt="">
                            </div>
                            <div class="form-group group-file" style="display: none;">
                                <div class="custom-file">
                                    <input type="file" class="custom-file-input" id="customFile" name="uploadFile">
                                    <label class="custom-file-label" for="customFile">Choisissez un fichier</label>
                                </div>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label>Type de projet <span class="text-danger">*</span></label>
                                <select class="form-control select2-example" name="projectType">
                                    {% for type in projectTypes %}
                                        <option value="{{ type.id }}"
                                                {% if projectParent.projectType and projectParent.projectType.slug == type.slug %}selected{% endif %}>
                                            {{ type.label }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="form-group col-md-6">
                                <label>Statut <span class="text-danger">*</span></label>
                                <select class="form-control select2-example" name="projectStatus">
                                    {% for status in projectStatus %}
                                        <option value="{{ status.id }}"
                                                {% if projectParent.projectStatus and projectParent.projectStatus.slug == status.slug %}selected{% endif %}>
                                            {{ status.label }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Nom du projet <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="title"
                                   value="{{ projectParent.title }}"
                                   aria-describedby="emailHelp" placeholder="Entrez le nom du projet" required>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label>Nombre d’arbres <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" name="countTrees"
                                    aria-describedby="emailHelp" placeholder="" disabled value="{{ treeCount }}">
                            </div>

                            <div class="form-group col-md-6">
                                <label>Date de début <span class="text-danger">*</span></label>
                                <input type="text" name="startDate" class="datepick form-control"
                                    value="{{ projectParent.startDate|date('d/mm/Y') }}">
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary">Enregistrer</button>
                    </form>
                </div>
            </div>


            <div class="card" id="localisation">
                <div class="card-header">
                    Localisation
                </div>
                <div class="card-body">
                    <form action="{{ path('project_parent_edit', {'id': projectParent.id}) }}" method="post">
                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label>Pays <span class="text-danger">*</span></label>
                                <input type="text" disabled class="form-control"
                                    aria-describedby="emailHelp" placeholder=""
                                    value="{{ projectParent.localisation.country }}">
                            </div>

                            <div class="form-group col-md-6">
                                <label>Région <span class="text-danger">*</span></label>
                                <input type="text" disabled class="form-control"
                                    aria-describedby="emailHelp" placeholder=""
                                    value="{{ projectParent.localisation.region }}">
                            </div>

                            <div class="form-group col-md-6">
                                <label>Ville <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="city"
                                    aria-describedby="emailHelp" placeholder="" value="{{ projectParent.city }}">
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary">Enregistrer</button>
                    </form>
                </div>
            </div>

            <div class="card" id="history">
                <div class="card-header">
                    Histoire du projet
                </div>
                <div class="card-body">
                    <form id="information_general" action="{{ path('project_parent_edit', {'id': projectParent.id}) }}" method="POST"
                          enctype="multipart/form-data">
                        <div class="form-group">
                            <label class="w-100">Contenu
                                <textarea name="history" class="form-control summernote-editor">{{ projectParent.history }}</textarea>
                            </label>
                        </div>

                        <button type="submit" class="btn btn-primary float-right">Enregistrer</button>
                    </form>
                </div>
            </div>

            <div class="card" id="galerie">
                <div class="card-header">
                    Galerie
                    <a href="#" data-toggle="modal" data-target="#editGalerieModal"
                       class="btn btn-primary text-white float-right" title="Ajouter un élément">Ajouter</a>
                </div>
                <div class="card-body">
                    {% if projectParent.galleries is not empty %}
                        <div class="gallery-container">
                            {% for gallery in projectParent.galleries %}
                                <div class="drawings">
                                    <div class="">
                                        <div class="image-hover">
                                            <img src="{{ gallery.thumbnailUrl }}" class="rounded"
                                                 alt="{{ gallery.caption }}">
                                            <div class="image-hover-body rounded">
                                                <div>
                                                    <a href="{{ gallery.url }}"
                                                       class="image-popup-gallery-item text-info" title="Visualiser">
                                                        <i class="ti-eye"></i>
                                                    </a>
                                                    <a href="#"
                                                       class="text-secondary ml-2"
                                                       data-toggle="modal"
                                                       data-target="#editGalerieModal"
                                                       data-gallery-id="{{ gallery.id }}"
                                                       data-gallery-caption="{{ gallery.caption }}"
                                                       data-gallery-url="{{ gallery.url }}"
                                                       data-gallery-format="{{ gallery.type }}"
                                                       title="Modifier">
                                                        <i class="ti-pencil"></i>
                                                    </a>
                                                    <a href="#"
                                                       data-toggle="modal"
                                                       data-target="#deleteModal"
                                                       data-delete-id="{{ gallery.id }}"
                                                       data-type="gallery"
                                                       class="text-danger ml-2"
                                                       title="Supprimer"
                                                    >
                                                        <i class="ti-trash"></i>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                        <h6 class="mb-1 mt-1">{{ gallery.caption }}</h6>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="text-center">Il n'y a pas de donnée</p>
                    {% endif %}
                </div>
            </div>


            <div class="card" id="sous-projets">
                <div class="card-header">
                    Sous-projets / Projets locaux
                    <a href="#" data-toggle="modal" data-target="#editSubprojectModal"
                       class="btn btn-primary text-white float-right" title="Ajouter un élément">Ajouter</a>
                </div>
                <div class="card-body">
                    {% if projectParent.subProjects is not empty %}
                        <div class="row">
                            {% for subProject in projectParent.subProjects %}
                                <div class="col-xl-4 col-lg-6">
                                    <div class="card">
                                        <div class="card-header">
                                            <img src="{{ subProject.banner }}"
                                                 alt="{{ subProject.banner }}" class="w-100">
                                        </div>
                                        <div class="card-body">
                                            <div class="d-flex align-items-center">
                                                <h5 class="mb-0">
                                                    <a href="#" class="link-2">{{ subProject.name }}</a>
                                                </h5>
                                                <div class="dropdown ml-auto">
                                                    <a href="{{    subProject.banner }}"
                                                       data-toggle="dropdown" aria-haspopup="true"
                                                       aria-expanded="false">
                                                        <i class="fa fa-ellipsis-v" aria-hidden="true"></i>
                                                    </a>
                                                    <div class="dropdown-menu dropdown-menu-right">
                                                        <a href="#"
                                                           data-toggle="modal"
                                                           data-target="#editSubprojectModal"
                                                           data-subproject-id="{{ subProject.id }}"
                                                           data-subproject-name="{{ subProject.name }}"
                                                           data-subproject-banner="{{ subProject.banner }}"
                                                           data-subproject-startdate="{{ subProject.startDate|date('d/m/Y') }}"
                                                           data-subproject-city="{{ subProject.city }}"
                                                           class="dropdown-item">
                                                            <i class="ti-pencil"></i>
                                                            Modifier
                                                        </a>
                                                        <a href="#" data-toggle="modal"
                                                           data-target="#deleteModal"
                                                           data-delete-id="{{ subProject.id }}"
                                                           data-type="subproject"
                                                           class="dropdown-item text-danger">
                                                            <i class="ti-trash"></i>
                                                            Supprimer
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="text-muted small mt-1 mb-3"><i data-feather="map-pin"
                                                                                       class="mr-2 width-15 height-15"></i>
                                                {{ projectParent.localisation.country }}
                                                , {{ projectParent.localisation.region }}
                                                , {{ subProject.city }}
                                            </div>

                                            {% if subProject.startDate and subProject.startDate|date('Y') > 0 %}
                                                <div class="row">
                                                    <div class="col">
                                                        <div class="text-muted mb-1 small"><i
                                                                    class="fa fa-calendar"></i>
                                                            Début
                                                        </div>
                                                        <div>{{ subProject.startDate|date('d/m/Y') }}</div>
                                                    </div>
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="text-center">Il n'y a pas de donnée</p>
                    {% endif %}
                </div>
            </div>

        </div>
    </div>
    <div class="modal" tabindex="-1" role="dialog" id="editGalerieModal">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Ajout/Modification galerie</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form id="gallery-edit" action="{{ path('gallery_new', {'entityId': projectParent.id,'entityType':'project-parent'}) }}"
                          method="POST"
                          enctype="multipart/form-data">
                        <div class="form-group">
                            <label>Titre de la photo</label>
                            <input type="text" class="form-control"
                                   aria-describedby="emailHelp" placeholder="" name="caption" required>
                        </div>

                        <div class="group-upload">
                            <label>Fichier image ou vidéo <span class="text-danger">*</span></label>
                            <div class="boxBanner">
                                <span class="ico-close">+</span>
                                <img class="boxBanner_img" src="" alt="">
                            </div>
                            <div class="form-group group-file" style="display: none;">

                                <div class="custom-file">
                                    <input type="file" class="custom-file-input" id="customFile" name="uploadFile">
                                    <label class="custom-file-label" for="customFile">Choisissez un fichier</label>
                                </div>
                                <small>Formats acceptés : jpeg, jpg, png, mp4, webm, ogg<br>
                                    Taille maximum image : 5 mo<br>
                                    Taille maximum vidéo : 20 mo
                                </small>
                            </div>
                        </div>

                        <input type="hidden" name="gallery_id">
                        <div class="w-100 text-right">
                            <button type="submit" class="btn btn-primary">Enregistrer</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="modal" tabindex="-1" role="dialog" id="editSubprojectModal">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Ajout/Modification sous-projet (Projets locaux)</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form id="sub-project-form" action="{{ path('subproject_new', {'entityId': projectParent.id,'entityType':'project-parent'}) }}"
                          method="POST"
                          enctype="multipart/form-data">
                        <div class="form-group">
                            <label>Nom du sous-projet / Projets locaux <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="name"
                                   aria-describedby="emailHelp" placeholder="" required>
                        </div>
                        <div class="group-upload">
                            <label>Bannière image <span class="text-danger">*</span></label>
                            <div class="boxBanner">
                                <span class="ico-close">+</span>
                                <img class="boxBanner_img" src="" alt="">
                            </div>
                            <div class="form-group group-file" style="display: none;">

                                <div class="custom-file">
                                    <input type="file" class="custom-file-input" id="customFile" name="uploadFile">
                                    <label class="custom-file-label" for="customFile">Choisissez un fichier</label>
                                </div>
                                <small>Dimension 707x205px</small>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Date de début <span class="text-danger">*</span></label>
                            <input type="text" name="startDate" class="datepick form-control">
                        </div>

                        <div class="form-group">
                            <label>Pays <span class="text-danger">*</span></label>
                            <input type="text" disabled class="form-control"
                                   aria-describedby="emailHelp" placeholder=""
                                   value="{{ projectParent.localisation.country }}">
                        </div>

                        <div class="form-group">
                            <label>Région <span class="text-danger">*</span></label>
                            <input type="text" disabled class="form-control"
                                   aria-describedby="emailHelp" placeholder=""
                                   value="{{ projectParent.localisation.region }}">
                        </div>

                        <div class="form-group">
                            <label>Ville <span class="text-danger">*</span></label>
                            <input type="text" class="form-control"
                                   name="city"
                                   aria-describedby="emailHelp" placeholder="">
                        </div>

                        <input type="hidden" name="subproject_id">
                        <div class="w-100 text-right">
                            <button type="submit" class="btn btn-primary">Enregistrer</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="modal" tabindex="-1" role="dialog" id="deleteModal">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Suppression</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p>Voulez-vous supprimer cet élément ? Cette action est irreversible.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Annuler</button>
                    <a href="#" id="confirmDelete" type="button" class="btn btn-primary">Supprimer</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <!-- Plugin scripts -->
    <script src="{{ asset('admin/vendors/select2/js/select2.min.js') }} "></script>
    <script src="{{ asset('admin/vendors/dataTable/datatables.min.js') }} "></script>
    <script src="{{ asset('admin/vendors/lightbox/jquery.magnific-popup.min.js') }} "></script>
    <script src="{{ asset('admin/vendors/datepicker/daterangepicker.js') }} "></script>
    <script src="{{ asset('admin/vendors/fixto/fixto.js') }} "></script>
    <script src="{{ asset('admin/assets/js/examples/pages/project-list.js') }} "></script>
    <script src="{{ asset('admin/assets/js/anchor.js') }} "></script>
    <script src="{{ asset('admin/vendors/summernote/summernote-bs4.min.js') }}"></script>


    <script>
        $(function () {
            $(document).ready(function ($) {

                $('#deleteModal').on('show.bs.modal', function (event) {
                    let deleteUrl = '';
                    var button = $(event.relatedTarget); // Button that triggered the modal
                    var deleteId = button.data('delete-id'); // Extract info from data-* attributes
                    var type = button.data('type'); // Extract info from data-* attributes
                    switch (type) {
                        case 'subproject':
                            deleteUrl = '{{ path('subproject_delete', {'entityId': projectParent.id, 'entityType': 'project-parent', 'id': 'SUBPROJECT_ID'}) }}';
                            deleteUrl = deleteUrl.replace('SUBPROJECT_ID', deleteId); // Replace placeholder with actual ID
                            break;
                        case'gallery':
                            deleteUrl = '{{ path('gallery_delete',{'entityId':projectParent.id,'entityType':'project-parent','id':'GALLERY_ID'}) }}';
                            deleteUrl = deleteUrl.replace('GALLERY_ID', deleteId);//ReplaceplaceholderwithactualID
                            break;

                        default:
                            break;
                    }
                    var modal = $(this);
                    modal.find('#confirmDelete').data('delete-url', deleteUrl);  // Update the href attribute
                });

                $('#editSubprojectModal').on('show.bs.modal', function (event) {
                    var button = $(event.relatedTarget); // Button that triggered the modal
                    var subprojectId = button.data('subproject-id');
                    var subprojectName = button.data('subproject-name');
                    var subprojectStartDate = button.data('subproject-startdate');
                    var subprojectCity = button.data('subproject-city');
                    var subprojectBanner = button.data('subproject-banner');

                    var modal = $(this);
                    if (subprojectId) {
                        modal.find('form').attr('action', '{{ path('subproject_edit', {'entityId': projectParent.id, 'entityType': 'project-parent', 'id': 'SUBPROJECT_ID'}) }}'.replace('SUBPROJECT_ID', subprojectId));
                        modal.find('input[name="subproject_id"]').val(subprojectId);
                    } else {
                        modal.find('form').attr('action', '{{ path('subproject_new', {'entityId': projectParent.id, 'entityType': 'project-parent'}) }}');
                    }
                    modal.find('input[name="name"]').val(subprojectName);
                    modal.find('input[name="startDate"]').val(subprojectStartDate);
                    modal.find('input[name="city"]').val(subprojectCity);

                    if (subprojectBanner) {
                        modal.find('.boxBanner_img').attr('src', subprojectBanner);
                        modal.find('.group-file').hide();
                        modal.find('.boxBanner').show();
                    } else {
                        modal.find('.boxBanner').hide();
                        modal.find('.group-file').show();
                    }

                    // Clear the file input
                    modal.find('input[name="uploadFile"]').val('');
                });

                $('#editGalerieModal').on('show.bs.modal', function (event) {
                    var button = $(event.relatedTarget); // Button that triggered the modal
                    var galleryId = button.data('gallery-id');
                    var galleryCaption = button.data('gallery-caption');
                    var galleryFormat = button.data('gallery-format');
                    var galleryImage = button.data('gallery-url');

                    var modal = $(this);
                    if (galleryId) {
                        modal.find('form').attr('action', '{{ path('gallery_edit', {'entityId': projectParent.id, 'entityType': 'project-parent', 'id': 'GALLERY_ID'}) }}'.replace('GALLERY_ID', galleryId));
                        modal.find('input[name="gallery_id"]').val(galleryId);
                    } else {
                        modal.find('form').attr('action', '{{ path('gallery_new', {'entityId': projectParent.id, 'entityType': 'project-parent'}) }}');
                    }
                    modal.find('form').attr('method', 'POST');
                    modal.find('input[name="caption"]').val(galleryCaption);
                    modal.find('select[name="format"]').val(galleryFormat);

                    if (galleryImage) {
                        modal.find('.boxBanner_img').attr('src', galleryImage);
                        modal.find('.group-file').hide();
                        modal.find('.boxBanner').show();
                    } else {
                        modal.find('.boxBanner').hide();
                        modal.find('.group-file').show();
                    }

                    // Clear the file input
                    //modal.find('input[name="file"]').val('');
                });


                $('.select2-example').select2({
                    placeholder: 'Selectionner'
                });

                $('input.datepick').daterangepicker({
                    singleDatePicker: true,
                    showDropdowns: true,
                    locale: {
                        format: 'DD/MM/YYYY', // Format français
                        applyLabel: "Appliquer",
                        cancelLabel: "Annuler",
                        daysOfWeek: ["Dim", "Lun", "Mar", "Mer", "Jeu", "Ven", "Sam"],
                        monthNames: [
                            "Janvier", "Février", "Mars", "Avril", "Mai", "Juin",
                            "Juillet", "Août", "Septembre", "Octobre", "Novembre", "Décembre"
                        ],
                        firstDay: 1 // Lundi comme premier jour de la semaine
                    }
                });


                let magnificPopupGalleryConfig = {
                    type: 'image',
                    gallery: {
                        enabled: true
                    }
                };
                $('.image-popup-gallery-item').magnificPopup(magnificPopupGalleryConfig);

                $('.app-sidebar-menu .list-group >a').on('click', function () {
                    $('.app-sidebar-menu .list-group >a').removeClass('active');
                    $(this).addClass('active');
                });

                $('.app-sidebar-menu').fixTo('body', {
                    zIndex: 1,
                    top: 75
                });

            });
        })
    </script>
{% endblock %}
