{% extends 'base.html.twig' %}

{% set menu_bondy = true %}
{% set menu_manage_prj_bondy = true %}
{% block body %}
    <div class="page-header justify-content-between">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href={{ path('admin_dashboard') }}>Accueil</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="{{ current_url }}">Gestion projets Bondy</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Liste des projets Bondy</li>
            </ol>
        </nav>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <h6 class="card-title">Filtres</h6>
                    <form>
                        <div class="row">
                            {% if (types) %}
                                <div class="col-lg-3 col-md-6">
                                    <div class="form-group">
                                        <label>Type de projet</label>
                                        <select class="select2-example" name="project_type" id="project-type">
                                            <option value="0">Tous</option>
                                            {% for type in types %}
                                            <option value="{{ type.id }}">{{ type.label }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>
                            {% endif %}
                            {% if (status) %}
                            <div class="col-lg-3 col-md-6">
                                <div class="form-group">
                                    <label>Statut</label>
                                    <select class="select2-example" name="project_status" id="project-status">
                                        <option value="0">Tous</option>
                                        {% for item in status %}
                                            <option value="{{ item.id }}">{{ item.label }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                            {% endif %}

                        </div>
                    </form>
                </div>
            </div>
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="table-projects-bondy" class="table table-lg">
                            <thead>
                            <tr>
                                <th class="no-sort">Nom du projet</th>
                                <th class="no-sort">Localisation</th>
                                <th class="text-center no-sort">Date début</th>
                                <th class="text-center no-sort">Nbr d'arbres</th>
                                <th class="text-center no-sort">Statut</th>
                                <th class="text-center no-sort">Type</th>
                                <th class="text-center no-sort">Actions</th>
                            </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal" tabindex="-1" role="dialog" id="deleteModal">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Suppression</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p>Voulez-vous supprimer cet élément ? Cet action est irreversible.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Annuler</button>
                    <button type="button" class="btn btn-primary">Supprimer</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        var url_ajax_prj_parent = "{{ path('project_parent_list_ajax') }}";
        var url_edit_prj_parent = "{{ path('project_parent_edit', {'id': 0}) }}";
        var url_show_prj_parent = "{{ path('project_parent_show', {'id': 0}) }}";
    </script>
    <script src="{{ asset('admin/assets/js/js_backoffice/project-parent-list.js') }}"></script>
{% endblock %}
