{% extends 'base.html.twig' %}

{% set menu_settings = true %}
{% set menu_manage_usage_type = true %}

{% block body %}
    <div class="page-header justify-content-between">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="{{ path('admin_dashboard') }}">Accueil</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="{{ current_url }}">Paramétrages</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Types d'utilisation des arbres</li>
            </ol>
        </nav>
        <div>
            <a href="#" data-toggle="modal"  data-target="#editUsageTypeModal" class="btn btn-outline-primary" title="List" >Ajouter</a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">

            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">

                        <table id="myTable" class="table table-striped table-bordered">
                            <thead>
                            <tr>
                                <th>Icone</th>
                                <th>Type d'utilisation</th>
                                <th>Action</th>
                            </tr>
                            </thead>
                            <tbody>
                                {% if usageTypes is not empty %}
                                    {% for usageType in usageTypes %}
                                        <tr>
                                            <td>
                                                <figure class="avatar avatar-sm mr-2">
                                                    <img src="{{ usageType.icon }}" class="rounded-circle" alt="avatar">
                                                </figure>
                                            </td>
                                            <td>{{  usageType.label }}</td>
                                            <td>
                                                <a href="javascript:void(0);" class="text-secondary" data-toggle="modal"  data-target="#editUsageTypeModal" title="Modifier"
                                                    data-id="{{ usageType.id }}" data-label="{{ usageType.label }}" data-icon="{{ usageType.icon }}" >
                                                    <i class="ti-pencil"></i>
                                                </a>
                                                <a href="javascript:void(0);" class="text-danger ml-2" data-toggle="modal" data-target="#deleteModal" title="Supprimer"
                                                    data-id="{{ usageType.id }}">
                                                    <i class="ti-trash"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                {% endif %}
                            </tbody>
                        </table>

                    </div>
                </div>
            </div>

        </div>
    </div>

    <div class="modal" tabindex="-1" role="dialog" id="editUsageTypeModal">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Modification</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form method="post" enctype="multipart/form-data" id="id-form-usage-type" action="{{ path('usage_type_edit') }}">
                        <div class="group-upload">
                            <label>Icone <span class="text-danger">*</span></label>
                            <div class="boxBanner">
                                <span class="ico-close text-dark">+</span>
                                <img class="boxBanner_img" src="" style="width: 75px; height: 75px;">
                            </div>
                            <div class="form-group group-file" style="display: none;">
                                <div class="custom-file">
                                    <input type="file" class="custom-file-input" name="iconFile">
                                    <label class="custom-file-label" for="customFile">Choisissez un fichier</label>
                                    <small>Formats acceptés : jpeg, jpg, png,svg<br>
                                        Taille maximum image : 5 mo <br>
                                        Dimension 29x26px
                                    </small>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Type d'utilisation<span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="label"
                                    aria-describedby="emailHelp" placeholder="" required>
                        </div>
                        <input type="hidden" name="id" value="">
                        {# <div class="form-group">
                            <label>Couleur<span class="text-danger">*</span></label>
                            <input type="text" class="colorpicker-example form-control" name="color" required>
                        </div> #}
                        <button type="submit" class="btn btn-primary">Enregistrer</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="modal" tabindex="-1" role="dialog" id="deleteModal">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Suppression</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p>Voulez-vous supprimer cet élément ? Cette information sera supprimée dans les projets concernés. Cet action est irreversible.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Annuler</button>
                    <button type="button" class="btn btn-primary" id="confirmDelete">Supprimer</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('admin/assets/js/js_backoffice/usage-type.js') }}"></script>
    <script src="{{ asset('admin/vendors/colorpicker/js/bootstrap-colorpicker.min.js') }}"></script>
    <script>
        $('#deleteModal').on('show.bs.modal', function (event) {
            let deleteUrl = '{{ path( 'usage_type_delete', { 'id': 'TYPE_ID'}) }}';
            deleteUrl = deleteUrl.replace('TYPE_ID', $(event.relatedTarget).data('id'));
            var button = $(event.relatedTarget);
            var deleteId = button.data('id');
            var modal = $(this);
            modal.find('#confirmDelete').data('delete-url', deleteUrl);
        });
    </script>
{% endblock %}
