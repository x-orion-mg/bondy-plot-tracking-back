{% extends 'base.html.twig' %}

{% set menu_settings = true %}
{% set menu_manage_tree_species = true %}

{% block body %}
    <div class="page-header justify-content-between">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="{{ path('admin_dashboard') }}">Accueil</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="{{  path('tree_species_index') }}">Paramétrages</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Especes d'arbre</li>
            </ol>
        </nav>
        <div>
            <a href="{{ path('tree_species_index') }}" class="btn btn-outline-primary" title="List">Retour</a>
        </div>
    </div>
    <div class="row">
        <div class="col-md-3">
            <div class="card">
                <div class="app-sidebar-menu">
                    <div class="list-group list-group-flush">
                        <a href="#infoge" class="list-group-item active d-flex align-items-center">
                            <i data-feather="globe" class="mr-2 width-15 height-15"></i>
                            Informations générales
                        </a>
                        <a href="#galerie" class="list-group-item d-flex align-items-center">
                            <i data-feather="image" class="mr-2 width-15 height-15"></i>
                            Galerie
                        </a>
                        <a href="#storytelling" class="list-group-item d-flex align-items-center">
                            <i data-feather="film" class="mr-2 width-15 height-15"></i>
                            Story telling / Les moments forts
                        </a>
                    </div>

                </div>
            </div>
        </div>
        <div class="col-md-9">
            <div class="card" id="infoge">
                <div class="card-header">
                    Informations générales
                </div>
                <div class="card-body">
                    {{ form_start(form, {attr: {'id': 'id-form-tree-species', 'enctype': 'multipart/form-data'}}) }}
                        <div class="form-row">
                            <div class="group-upload col-md-6">
                                <label>Banniére Image<span class="text-danger">*</span></label>
                                <div class="boxBanner">
                                    <span class="ico-close" style="color: black!important;">+</span>
                                    <img class="boxBanner_img" src="{{ treeSpecy.banner }}">
                                </div>
                                <div class="form-group group-file" style="display: none;">
                                    <div class="custom-file">
                                        <input type="file" class="custom-file-input" name="uploadFile">
                                        <label class="custom-file-label" for="customFile">Choisissez une image</label>
                                    </div>
                                    <small>Largeur maximal 200px</small>
                                </div>
                            </div>
                            <div class="group-upload">
                                <label>Icone <span class="text-danger">*</span></label>
                                <div class="boxBanner">
                                    <span class="ico-close">+</span>
                                    <img class="boxBanner_img" src="{{ treeSpecy.icon }}" style="width: 75px; height: 75px;">
                                </div>
                                <div class="form-group group-file" style="display: none;">

                                    <div class="custom-file">
                                        <input type="file" class="custom-file-input" name="iconFile">
                                        <label class="custom-file-label" for="customFile">Choisissez un fichier</label>
                                        <small>Formats acceptés : jpeg, jpg, png,svg<br>
                                            Taille maximum image : 5 mo <br>
                                            Dimension 29x26px
                                        </small>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group col-md-6">
                                {{ form_row(form.commonName) }}
                            </div>
                            <div class="form-group col-md-6">
                                {{ form_row(form.scientificName) }}
                            </div>
                            <div class="form-group col-md-6">
                                {{ form_row(form.usageType) }}
                            </div>
                            <div class="form-group col-md-6">
                                {{ form_row(form.color) }}
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary float-right">Enregistrer</button>
                    {{ form_end(form) }}
                </div>
            </div>

            <div class="card" id="galerie">
                <div class="card-header">
                    Galerie
                    {% if galleries|length < 5 %}
                        <a href="javascript:void(0)" data-toggle="modal" data-target="#editGalerieModal"
                        class="btn btn-primary text-white float-right" title="Ajouter un élément">Ajouter</a>
                    {% endif %}
                </div>
                <div class="card-body">
                    {% if galleries is not empty %}
                        <div class="gallery-container">
                            {% for gallery in galleries %}
                                <div class="drawings">
                                    <div class="image-hover">
                                        <img src="{{ gallery.thumbnailUrl }}" class="rounded" alt="image">
                                        <div class="image-hover-body rounded">
                                            <div>
                                                <a href="{{ gallery.url }}"
                                                   class="image-popup-gallery-item text-info" title="Visualiser">
                                                    <i class="ti-eye"></i>
                                                </a>
                                                <a href="javascript:void(0)"
                                                   class="text-secondary ml-2"
                                                   data-toggle="modal"
                                                   data-target="#editGalerieModal"
                                                   data-gallery-id="{{ gallery.id }}"
                                                   data-gallery-caption="{{ gallery.caption }}"
                                                   data-gallery-url="{{ gallery.url }}"
                                                   data-gallery-format="{{ gallery.type }}"
                                                   title="Modifier">
                                                    <i class="ti-pencil"></i>
                                                </a>
                                                <a href="javascript:void(0)"
                                                   data-toggle="modal"
                                                   data-target="#deleteModal"
                                                   data-delete-id="{{ gallery.id }}"
                                                   data-type="gallery"
                                                   class="text-danger ml-2"
                                                   title="Supprimer"
                                                >
                                                    <i class="ti-trash"></i>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                    <h6 class="mb-1 mt-1">{{ gallery.caption }}</h6>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="text-center">Il n'y a pas de donnée</p>
                    {% endif %}
                </div>
            </div>

            <div class="card" id="storytelling">
                <div class="card-header">
                    Story telling
                    <a href="{{ path('story_telling_new', {'entityId': treeSpecy.id, 'entityType': 'tree-species'}) }}"
                       class="btn btn-primary text-white float-right" title="Ajouter un élément">Ajouter</a>
                </div>
                <div class="card-body">
                    {% if storyTelling is not empty %}
                        <div class="row">
                            {% for story in storyTelling %}
                                <div class="col-xl-4 col-lg-6">
                                    <div class="card">
                                        <div class="card-header">
                                            <img src="{{ story.bannerImage }}" class="w-100" alt="{{ story.title }}">
                                        </div>
                                        <div class="card-body">
                                            <div class="d-flex align-items-center">
                                                <h5 class="mb-0">
                                                    <a href="#" class="link-2">{{ story.title }}</a>
                                                </h5>
                                                <div class="dropdown ml-auto">
                                                    <a href="#"
                                                       data-toggle="dropdown"
                                                       aria-haspopup="true"
                                                       aria-expanded="false">
                                                        <i class="fa fa-ellipsis-v" aria-hidden="true"></i>
                                                    </a>
                                                    <div class="dropdown-menu dropdown-menu-right">
                                                        <a href="{{ path('story_telling_edit', {'entityId': treeSpecy.id, 'entityType': 'tree-species', 'id': story.id}) }}"
                                                           class="dropdown-item"><i class="ti-pencil"></i> Modifier</a>
                                                        <a href="#" data-toggle="modal"
                                                           data-target="#deleteModal"
                                                           data-delete-id="{{ story.id }}"
                                                           data-type="storytelling"
                                                           class="dropdown-item text-danger"><i class="ti-trash"></i>
                                                            Supprimer</a>
                                                    </div>
                                                </div>
                                            </div>

                                            <p>{{ story.description }}</p>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="text-center">Il n'y a pas de donnée</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
    <div class="modal" tabindex="-1" role="dialog" id="editGalerieModal">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Ajout/Modification galerie</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form id="gallery-edit" method="post">
                        <div class="form-group">
                            <label>Titre de la photo</label>
                            <input type="text" class="form-control" name="caption"
                                   aria-describedby="emailHelp" placeholder="" required>
                        </div>

                        <div class="group-upload">
                            <label>Fichier image ou vidéo <span class="text-danger">*</span></label>
                            <div class="boxBanner">
                                <span class="ico-close">+</span>
                                <img class="boxBanner_img" src="" alt="">
                            </div>
                            <div class="form-group group-file" style="display: none;">

                                <div class="custom-file">
                                    <input type="file" class="custom-file-input" id="customFile" name="uploadFile">
                                    <label class="custom-file-label" for="customFile">Choisissez un fichier</label>
                                </div>
                                <small>Formats acceptés : jpeg, jpg, png, mp4, webm, ogg<br>
                                    Taille maximum image : 5 mo<br>
                                    Taille maximum vidéo : 20 mo
                                </small>
                            </div>
                        </div>
                        <input type="hidden" name="gallery_id">
                        <button type="submit" class="btn btn-primary">Enregistrer</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <div class="modal" tabindex="-1" role="dialog" id="deleteModal">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Suppression</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p>Voulez-vous supprimer cet élément ? Cet action est irreversible.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Annuler</button>
                    <a href="#" id="confirmDelete" type="button" class="btn btn-primary">Supprimer</a>
                </div>
            </div>
        </div>
    </div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('admin/vendors/lightbox/jquery.magnific-popup.min.js') }}"></script>
    <script src="{{ asset('admin/vendors/fixto/fixto.js') }}"></script>
    <script src="{{ asset('admin/assets/js/anchor.js') }}"></script>
    <script src="{{ asset('admin/assets/js/table-repeater.js') }}"></script>
    <script src="{{ asset('admin/assets/js/js_backoffice/tree-species.js') }}"></script>
    <script>
        $('#editGalerieModal').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget); // Button that triggered the modal
            var galleryId = button.data('gallery-id');
            var galleryCaption = button.data('gallery-caption');
            var galleryFormat = button.data('gallery-format');
            var galleryImage = button.data('gallery-url');

            var modal = $(this);
            if (galleryId) {
                modal.find('form').attr('action', '{{ path('gallery_edit', {'entityId': treeSpecy.id, 'entityType': 'tree-species', 'id': 'GALLERY_ID'}) }}'.replace('GALLERY_ID', galleryId));
                modal.find('input[name="gallery_id"]').val(galleryId);
            } else {
                modal.find('form').attr('action', '{{ path('gallery_new', {'entityId': treeSpecy.id, 'entityType': 'tree-species'}) }}');
            }
            modal.find('form').attr('method', 'POST'); // Ensure the method is POST
            modal.find('input[name="caption"]').val(galleryCaption);
            modal.find('select[name="format"]').val(galleryFormat);

            if (galleryImage) {
                modal.find('.boxBanner_img').attr('src', galleryImage);
                modal.find('.group-file').hide();
                modal.find('.boxBanner').show();
            } else {
                modal.find('.boxBanner').hide();
                modal.find('.group-file').show();
            }
        });
        $('#deleteModal').on('show.bs.modal', function (event) {
            let deleteUrl = '';
            var button = $(event.relatedTarget); // Button that triggered the modal
            var deleteId = button.data('delete-id'); // Extract info from data-* attributes
            var type = button.data('type'); // Extract info from data-* attributes
            switch (type) {
                case 'storytelling':
                    deleteUrl = '{{ path('story_telling_delete', {'entityId': treeSpecy.id, 'entityType': 'tree-species', 'id': 'STORY_TELLING_ID'}) }}';
                    deleteUrl = deleteUrl.replace('STORY_TELLING_ID', deleteId); // Replace placeholder with actual ID
                    break;
                case'gallery':
                    deleteUrl = '{{ path('gallery_delete', {'entityId': treeSpecy.id,'entityType': 'tree-species', 'id':'GALLERY_ID'}) }}';
                    deleteUrl = deleteUrl.replace('GALLERY_ID', deleteId);//ReplaceplaceholderwithactualID
                    break;

                default:
                    break;
            }
            var modal = $(this);
            modal.find('#confirmDelete').data('delete-url', deleteUrl);  // Update the href attribute
        });
    </script>
{% endblock %}
