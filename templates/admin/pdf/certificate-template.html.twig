<!DOCTYPE html>
<html lang="en">

	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Certification Franklin</title>
	</head>

	<style>
		*,
		*::before,
		*::after {
			margin: 0;
			padding: 0;
			box-sizing: border-box;
		}

		@font-face {
			font-family: "DMSans";
			font-weight: 700;
			src: url("{{ absolute_url(asset('admin/fonts/DMSans-Bold.woff2')) }}") format("woff2");
		}

		@font-face {
			font-family: "DMSans";
			font-weight: 400;
			src: url("{{ absolute_url(asset('admin/fonts/DMSans-Regular.woff2')) }}") format("woff2");
		}


		*,
		*::before,
		*::after {
			margin: 0;
			padding: 0;
			box-sizing: border-box;
		}

		body {
			font-family: "DMSans", sans-serif;
			font-weight: 400;
		}

		.container {
			width: 1073px;
			height: 743.5px;
			background-color: #fff;
			display: flex;
			align-items: center;
			border: 10px solid #1B5A2E;
			padding: 15px;
		}

		.wrapper {
			border: 5px solid #1B5A2E;
			padding: 15px;
			width: 1033px;
			height: 703px;
			position: relative;
		}

		.content_top {
			width: 70%;
			margin-top: 20px;


			position: absolute;
			left: 50%;
			transform: translateX(-50%);
		}

		.content_top .logo {
			display: block;
			position: relative;
			height: 253px;
			margin-bottom: 10px;
		}

		.content_top .logo img {
			width: 180px;
			height: auto;
			position: absolute;
			left: 50%;
			transform: translateX(-50%);
		}


		.content_top h1 {
			font-size: 50px;
			font-weight: 400;
			width: 100%;
			text-align: center;
			padding-bottom: 10px;
			border-bottom: 3px solid #1B5A2E;
			margin-bottom: 25px;
		}

		.content_top p {
			font-size: 20px;
			font-weight: 400;
			text-align: center;
			color: #595959;
		}


		.content_bottom {
			position: absolute;
			bottom: 10px;
			width: 90%;
			left: 50%;
			transform: translateX(-50%);
			height: 190px;
		}

		.content_bottom .logo {
			position: absolute;
			right: 0;
			bottom: 0;
			width: 100%;
		}

		.content_bottom .logo img {
			width: 106px;
			margin-left: 48px;
		}
	</style>

	<body>
		<div class="container">
			<div class="wrapper">

				<div class="content_top">
					<div class="logo">
						<img src='data:image/svg+xml;base64,'/>
					</div>

					<h1>PLANTATION CERTIFICATE</h1>

					<p>
						Bôndy certifies that
						{{ totalTreeCount|number_format(0, ' ', ' ') }}
						trees have been planted as part of the landscape restoration efforts in collaboration with local communities</p>
				</div>

				<div class="content_bottom">
					<div style="width: 310px;position: absolute; left: 0; height: 188px;">
						<strong style="font-size: 16px; color: #595959;">Certificate for :
							{{ user.lastName }}</strong>

					</div>

					<div style="width: 150px; height: 188px; position: absolute; left: 50%; transform: translateX(-50%);">
						<div class="logo">
							<img src='data:image/svg+xml;base64,'/>
						</div>

						<p style="font-size: 12px; position: absolute; bottom: 0; right: 0; width: 130px; text-align: center; line-height: 10px; color: #595959; font-weight: bold;">Actor of the agricultural transition</p>
					</div>

					<div style="width: 310px; position: absolute; right: 0; height: 188px;">
						<strong style="font-size: 16px; color: #595959;">Date :
							{{ "now"|date("m/d/Y") }}</strong>
					</div>
				</div>

			</div>
		</div>
	</body>

</html>
