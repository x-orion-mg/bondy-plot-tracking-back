<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>{{ app_name }}</title>

    {% block stylesheets %}
    <!-- Favicon -->
    <link rel="shortcut icon" href="{{ asset('admin/assets/media/image/icon-bondy.png') }}"/>

    <!-- Plugin styles -->
    <link rel="stylesheet" href="{{ asset('admin/vendors/bundle.css') }}" type="text/css">

    <!-- App styles -->
    <link rel="stylesheet" href="{{ asset('admin/assets/css/app.min.css') }}" type="text/css">
    <style>
        label.error {
            position: absolute;
            bottom: -29px;
            left:0;
            font-size: 12px;
            color: red;
            text-align: left;
            width: 100%;
        }
        .form-group{
            position: relative;
        }

        .form-control {
            margin-bottom: 34px!important;
        }

    </style>
    {% endblock %}
</head>
<body class="form-membership">

    <!-- begin::preloader-->
    <div class="preloader">
        <div class="preloader-icon"></div>
    </div>
    <!-- end::preloader -->

    <div class="form-wrapper">
        <!-- logo -->
        <div id="logo">
            <img class="logo" src="{{ asset('admin/assets/media/image/image-dashboard.png') }}" alt="image" style="width: 80%;">
        </div>
        <!-- ./ logo -->
        <h5>Connexion</h5>

        <!-- form -->
        <form method="post" enctype="application/multipart-formdata" id="login-form">
            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            {% if app.user %}
                <div class="mb-3">
                    Vous êtes connecté(e) en tant que <strong>{{ app.user.userIdentifier }}</strong><br><br>
                    Se rediriger vers le <a href="{{ path('admin_dashboard') }}">Tableau de bord</a> </br>ou <a href="{{ path('logout') }}">Se déconnecter</a>   
                </div>
            {% endif %}

            <div class="form-group">
                <input type="email" class="form-control" placeholder="Email" autocomplete="email"
                value="{{ last_username }}" name="email" id="inputEmail" required autofocus>
            </div>

            <div class="form-group">
                <input type="password" name="password" id="inputPassword" 
                class="form-control" placeholder="Mot de passe" autocomplete="current-password" required>
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            
        
            <div class="form-group d-flex justify-content-between">
                <div class="custom-control custom-checkbox">
                    <input type="checkbox" class="custom-control-input" id="id-remember-me" name="_remember_me">
                    <label class="custom-control-label" for="id-remember-me">Se souvenir de moi</label>
                </div>
                <p><a href="{{ path('forgot_password') }}" >Mot de passe oublié ?</a></p>
            </div>
            <button type="submit" class="btn btn-primary btn-block btn-login text-white">Se connecter</button>
        </form>
        <!-- ./ form -->
        
    </div>

    {% block javascripts %}
        <!-- Plugin scripts -->
        <script src="{{ asset('admin/vendors/bundle.js') }}"></script>

        <!-- App scripts -->
        <script src="{{ asset('admin/assets/js/app.min.js') }}"></script>
        <script src="{{ asset('admin/assets/js/login.js') }}"></script>
        <script src="{{ asset('admin/assets/js/js_backoffice/lib/jquery.validate.min.js') }}"></script>
        <script src="{{ asset('admin/assets/js/js_backoffice/form_validation.js') }}"></script>
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                toastr.options = {
                    "closeButton": false,
                    "progressBar": true,
                    "timeOut": "5000",
                    "positionClass": "toast-top-center"
                };
                {% for type, messages in app.flashes %}
                {% for message in messages %}
                toastr.{{ type }}('{{ message|escape('js') }}');
                {% endfor %}
                {% endfor %}
            });
        </script>
    {% endblock %}
</body>
</html>
