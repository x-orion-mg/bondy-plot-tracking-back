<body class="form-membership">

<!-- begin::preloader-->
<div class="preloader">
    <div class="preloader-icon"></div>
</div>
<!-- end::preloader -->

<div class="form-wrapper">

    <!-- logo -->
    <div id="logo">
        <img class="logo" src="{{ asset('admin/assets/media/image/image-dashboard.png') }}" alt="dashboard"
             style="width: 80%;">
    </div>
    <!-- ./ logo -->

    <h5>Créer un nouveau mot de passe</h5>

    <!-- form -->
    <form method="post" action="{{ path('reset_password_post', {uuid: uuid}) }}" id="id-update-password">
        <div class="form-group">
            <input type="password" id="password" name="user_password" class="form-control"
                   placeholder="Entrez votre nouveau mot de passe" required>
        </div>
        <div class="form-group">
            <input type="password" id="confirm_password" name="user_confirm_password" class="form-control"
                   placeholder="Confirmez votre mot de passe" required>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Réinitialiser le mot de passe</button>
        <hr>

        ou
        <a href="{{ path('login') }}" class="btn btn-sm btn-outline-light ml-1">Se connecter !</a>
    </form>
    <!-- ./ form -->

</div>

<!-- Plugin scripts -->
<script src="{{ asset('admin/vendors/bundle.js') }}"></script>

<!-- App scripts -->
<script src="{{ asset('admin/assets/js/app.min.js') }}"></script>
<script src="{{ asset('admin/assets/js/js_backoffice/lib/jquery.validate.min.js') }}"></script>
<script src="{{ asset('admin/assets/js/js_backoffice/form_validation.js') }}"></script>
