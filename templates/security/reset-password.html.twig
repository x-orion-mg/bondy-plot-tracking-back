    document.addEventListener('DOMContentLoaded', function () {
        toastr.options = {
            "closeButton": false,
            "progressBar": true,
            "timeOut": "5000",
            "positionClass": "toast-top-center"
        };
        {% for type, messages in app.flashes %}
        {% for message in messages %}
        toastr.{{ type }}('{{ message|escape('js') }}');
        {% endfor %}
        {% endfor %}
    });
</script>
</body>
</html>