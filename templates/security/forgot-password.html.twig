<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Plot Tracking by Bôndy</title>

    <!-- Favicon -->
    <link rel="shortcut icon" href="{{ asset('admin/assets/media/image/icon-bondy.png') }}"/>

    <!-- Plugin styles -->
    <link rel="stylesheet" href="{{ asset('admin/vendors/bundle.css') }}" type="text/css">

    <!-- App styles -->
    <link rel="stylesheet" href="{{ asset('admin/assets/css/app.min.css') }}" type="text/css">
    <link rel="stylesheet" href="{{ asset('admin/assets/css/global.css') }}" type="text/css">
    <style>
        label.error {
            position: absolute;
            bottom: -29px;
            left:0;
            text-align: left;
            width: 100%;
        }
        .form-group{
            position: relative;
        }

        .form-control {
            margin-bottom: 34px!important;
        }

    </style>
</head>
<body class="form-membership">

<!-- begin::preloader-->
<div class="preloader">
    <div class="preloader-icon"></div>
</div>
<!-- end::preloader -->

<div class="form-wrapper">

    <!-- logo -->
    <div id="logo">
        <img class="logo" src="{{ asset('admin/assets/media/image/image-dashboard.png') }}" alt="dashboard"
             style="width: 80%;">
    </div>
    <!-- ./ logo -->

    <h5>Réinitialiser le mot de passe</h5>

    <!-- form -->
    <form method="post" action="{{ path('send_reset_link') }}" id="id-resend-link">
        <div class="form-group">
            <input type="email" id="email" name="email" class="form-control" placeholder="Entrez votre email" required
                   autofocus>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Envoyer le lien de réinitialisation</button>
        <hr>

        ou
        <a href="{{ path('login') }}" class="btn btn-sm btn-outline-light ml-1">Se connecter !</a>
    </form>
    <!-- ./ form -->

</div>

<!-- Plugin scripts -->
<script src="{{ asset('admin/vendors/bundle.js') }}"></script>

<!-- App scripts -->
<script src="{{ asset('admin/assets/js/app.min.js') }}"></script>
<script src="{{ asset('admin/assets/js/js_backoffice/lib/jquery.validate.min.js') }}"></script>
<script src="{{ asset('admin/assets/js/js_backoffice/form_validation.js') }}"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        toastr.options = {
            "closeButton": false,
            "progressBar": true,
            "timeOut": "5000",
            "positionClass": "toast-top-center"
        };
        {% for type, messages in app.flashes %}
        {% for message in messages %}
        toastr.{{ type }}('{{ message|escape('js') }}');
        {% endfor %}
        {% endfor %}
    });
</script>
</body>
</html>